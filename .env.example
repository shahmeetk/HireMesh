# HireMesh environment (copy to $HIREMESH_HOME/.env — never commit real values)

HIREMESH_HOME=/path/to/hiremesh-data
HIREMESH_TZ=Asia/Dubai

CANDIDATE_NAME={{CANDIDATE_NAME}}
CANDIDATE_EMAIL=candidate@example.com
CANDIDATE_PHONE=+1-555-0100
CANDIDATE_LINKEDIN=https://linkedin.com/in/{{CANDIDATE_SLUG}}

# Reactive Resume (optional — required for live JD tailoring)
RXRESU_BASE_URL=https://api.rxresu.me
RXRESU_API_KEY_PATH=~/.config/rxresu_api_key
RXRESU_MASTER_RESUME_ID=YOUR_MASTER_RESUME_ID
RXRESU_COVER_TEMPLATE_ID=YOUR_COVER_TEMPLATE_ID
HIREMESH_MASTER_PDF=/path/to/master_resume.pdf

# Optional discovery
LI_GUEST=0
HIREMESH_USER_AGENT=HireMeshBot/1.0 (personal job search; +mailto:candidate@example.com)
